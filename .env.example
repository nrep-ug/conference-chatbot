OLLAMA_URL=http://localhost:11434

# Model options for local testing and deployment.
# Make sure the selected model exists on the server: ollama pull gemma2:2b
CHAT_MODEL=gemma2:2b

EMBED_MODEL=nomic-embed-text

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conference_docs

PORT=3000

CHAT_KEEP_ALIVE=30m
EMBED_KEEP_ALIVE=30m
CHAT_NUM_CTX=1024
CHAT_NUM_PREDICT=160
CHAT_NUM_THREAD=12

RAG_SEARCH_LIMIT=1
RAG_MAX_CONTEXT_CHARS=1600
ANSWER_CACHE_TTL_MS=300000
ANSWER_CACHE_MAX=100
