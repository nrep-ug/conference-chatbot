# =============================================================================
# Conference Chatbot Environment
# Copy this file to `.env.local` and fill in the private values.
# `.env.local` is the single source of runtime environment variables for PM2.
# =============================================================================

# -----------------------------------------------------------------------------
# App Runtime
# -----------------------------------------------------------------------------
# Port used by `next dev`, `next start`, and PM2.
PORT=3000

# Public NREP logo used by the chatbot and admin console. `NEXT_PUBLIC_`
# variables are embedded into the browser bundle when `next build` runs.
NEXT_PUBLIC_NREP_LOGO_URL=https://appwrite.nrep.ug/v1/storage/buckets/67e0415e002bfc51380a/files/69cd389e003ac4a99db6/view?project=66bcc8450005201fa1af&mode=admin

# -----------------------------------------------------------------------------
# Ollama
# -----------------------------------------------------------------------------
# Local or remote Ollama HTTP endpoint.
OLLAMA_URL=http://localhost:11434
# Per-request deadline, kept below common five-minute HTTP transport limits.
# A longer timeout does not make an oversized CPU-only model faster.
OLLAMA_TIMEOUT_MS=120000

# Chat model used to write final user-facing answers.
# Make sure the selected model exists on the server, for example:
#   ollama pull qwen2.5:7b
#
# CPU-only benchmark baseline, not a guarantee of response quality or latency.
# Other options to benchmark:
# CHAT_MODEL=phi3:mini
# CHAT_MODEL=gemma2:2b
# CHAT_MODEL=qwen2.5:3b
# CHAT_MODEL=deepseek-r1:8b
# CHAT_MODEL=gemma2:9b
# CHAT_MODEL=command-r
CHAT_MODEL=qwen2.5:7b

# Planner model used to decide which public REC tables should be queried.
# This can be the same model as CHAT_MODEL.
# PLANNER_MODEL=phi3:mini
# PLANNER_MODEL=gemma2:2b
# PLANNER_MODEL=qwen2.5:3b
# PLANNER_MODEL=deepseek-r1:8b
# PLANNER_MODEL=gemma2:9b
# PLANNER_MODEL=command-r
PLANNER_MODEL=qwen2.5:7b

# Embedding model used for Qdrant ingestion and retrieval.
EMBED_MODEL=nomic-embed-text

# Keep models loaded in Ollama between requests.
CHAT_KEEP_ALIVE=30m
PLANNER_KEEP_ALIVE=30m
EMBED_KEEP_ALIVE=30m

# Chat model performance and output controls.
CHAT_NUM_CTX=8192
CHAT_NUM_PREDICT=360
# Multi-part/synthesis replies can grow above CHAT_NUM_PREDICT, up to this ceiling.
CHAT_MAX_NUM_PREDICT=1024
CHAT_NUM_THREAD=12
# Reject unusually large chat payloads before planner/model processing.
CHAT_MAX_QUESTION_CHARS=4000
# Bound recent browser-supplied conversation history before it reaches retrieval
# or either model. History is request-scoped and is not persisted by the server.
CHAT_HISTORY_MAX_MESSAGES=8
CHAT_HISTORY_MAX_MESSAGE_CHARS=1200
CHAT_HISTORY_MAX_TOTAL_CHARS=4800

# -----------------------------------------------------------------------------
# Appwrite Source Data
# -----------------------------------------------------------------------------
# Appwrite project and API key. Keep APPWRITE_API_KEY server-only.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# HR database and public REC table IDs used by the chatbot.
APPWRITE_DATABASE_ID=
APPWRITE_REC_CONFERENCES_TABLE_ID=
APPWRITE_REC_PROGRAM_TABLE_ID=
APPWRITE_REC_PROGRAM_TIME_BLOCKS_TABLE_ID=
APPWRITE_REC_SESSIONS_TABLE_ID=
APPWRITE_REC_SPONSOR_CATEGORIES_TABLE_ID=
APPWRITE_REC_SPONSORS_TABLE_ID=
APPWRITE_REC_MEDIA_ITEMS_TABLE_ID=
APPWRITE_REC_CONFERENCE_REPORTS_TABLE_ID=

# Appwrite request timeout in milliseconds.
APPWRITE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Generated REC Snapshot
# -----------------------------------------------------------------------------
# The chatbot reads generated REC data first, then falls back to Appwrite unless
# REC_SNAPSHOT_STRICT=true.
REC_SNAPSHOT_ENABLED=true
REC_SNAPSHOT_STRICT=false
REC_DATA_CACHE_TTL_MS=300000

# Token for the legacy protected refresh endpoint:
# POST /api/admin/rec-data/refresh
REC_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Admin Console Authentication
# -----------------------------------------------------------------------------
# Runtime account store. The actual JSON file is ignored by git.
ADMIN_AUTH_FILE=data/admin/admin-users.json

# Admin-managed public venue and visitor information. The runtime file is
# ignored by git; only its empty example template is committed.
CONFERENCE_KNOWLEDGE_FILE=data/admin/conference-knowledge.json

# Long random secret used to sign admin login codes and session tokens.
ADMIN_AUTH_SECRET=

# Admin session and email code lifetimes in milliseconds.
ADMIN_SESSION_TTL_MS=604800000
ADMIN_LOGIN_CODE_TTL_MS=600000
# Avoid sending another code to the same allowed address within this window.
ADMIN_LOGIN_CODE_COOLDOWN_MS=60000

# -----------------------------------------------------------------------------
# SMTP For Admin Login Codes
# -----------------------------------------------------------------------------
# Use SMTP_SECURE=true for port 465. Use SMTP_SECURE=false and
# SMTP_STARTTLS=true for most port 587 providers.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Qdrant Vector Store
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conference_docs

# -----------------------------------------------------------------------------
# Retrieval And Answering
# -----------------------------------------------------------------------------
# The request resolver budgets evidence separately for each part and edition.
# These size settings bound its evidence; enabled/mode control the legacy full
# snapshot fallback if request preparation is unavailable.
REC_FULL_CONTEXT_ENABLED=true
REC_FULL_CONTEXT_MODE=fallback
REC_FULL_CONTEXT_MAX_CHARS=18000
# Normal request-aware retrieval uses a smaller, ranked per-request budget.
REC_REQUEST_CONTEXT_MAX_CHARS=9000
REC_FULL_CONTEXT_SCHEMA_MAX_CHARS=2500

# Semantic fallback retrieval.
RAG_SEARCH_LIMIT=1
RAG_MAX_CONTEXT_CHARS=1600
RAG_MIN_SEARCH_SCORE=0.52

# Optional Qdrant snippets appended to broad direct Appwrite answers.
QDRANT_COMPLEMENT_ENABLED=false
# Optional semantic enrichment must not hold up structured answers indefinitely.
QDRANT_COMPLEMENT_TIMEOUT_MS=3000
QDRANT_COMPLEMENT_MODE=append
QDRANT_COMPLEMENT_SEARCH_LIMIT=3
QDRANT_COMPLEMENT_MAX_CONTEXT_CHARS=2400
QDRANT_COMPLEMENT_MIN_SCORE=0.52
QDRANT_COMPLEMENT_SNIPPET_CHARS=700

# Optional full indexed REC context for broad/advisory model-backed answers.
QDRANT_FULL_CONTEXT_ENABLED=false
QDRANT_FULL_CONTEXT_MODE=broad
QDRANT_FULL_CONTEXT_MAX_CHARS=12000
QDRANT_FULL_CONTEXT_SCROLL_LIMIT=128

# -----------------------------------------------------------------------------
# Planner
# -----------------------------------------------------------------------------
PLANNER_ENABLED=true
PLANNER_NUM_CTX=2048
PLANNER_NUM_PREDICT=220
PLANNER_TEMPERATURE=0
PLANNER_NUM_THREAD=12
PLANNER_MAX_OPERATIONS=4
PLANNER_MAX_ROWS_PER_OPERATION=12
PLANNER_MAX_CONTEXT_CHARS=3200
PLANNER_SCHEMA_MAX_CHARS=2200

# -----------------------------------------------------------------------------
# Cache And Diagnostics
# -----------------------------------------------------------------------------
ANSWER_CACHE_TTL_MS=300000
ANSWER_CACHE_MAX=100
CHAT_DIAGNOSTIC_LOGS=false
