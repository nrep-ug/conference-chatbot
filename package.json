{
  "name": "conference-chatbot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test && npm run lint",
    "eval:chat": "node --env-file=.env.local scripts/evaluate-chat.js",
    "lint": "eslint",
    "export:rec": "node --env-file=.env.local scripts/export-rec-snapshot.js",
    "ingest": "node --env-file=.env.local scripts/ingest.js",
    "refresh:rec": "npm run export:rec && npm run ingest"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4"
  }
}
